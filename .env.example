# ローカルテスト用環境変数 (.env にコピーして値を設定)

# --- AI ニュース日報 / ISMS週次レポート ---
ANTHROPIC_API_KEY=sk-ant-...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SINCE_HOURS=24

# --- Claude API 月次利用レポート ---
# Anthropic Console → API Keys → Admin keys で作成した Admin API Key
ANTHROPIC_ADMIN_KEY=sk-ant-admin-...
# 通知先 Slack Incoming Webhook URL（専用チャンネル推奨）
SLACK_WEBHOOK_URL_USAGE=https://hooks.slack.com/services/...
